AUTH_SECRET=replace-with-strong-random-secret
AUTH_USE_DATABASE=false
NEXTAUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

APPLE_SERVICE_ID=replace-with-apple-service-id
APPLE_TEAM_ID=replace-with-apple-team-id
APPLE_KEY_ID=replace-with-apple-key-id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-apple-private-key\n-----END PRIVATE KEY-----"

# Option A: discrete postgres fields (recommended when password contains special chars)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=telloria-user-registry
PGUSER=postgres
PGPASSWORD=replace-with-db-password

# Option B: full connection string
# DATABASE_URL=postgresql://user:password@host:5432/database

# Set true if your DB requires SSL
DATABASE_SSL=false
